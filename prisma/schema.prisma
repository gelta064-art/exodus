// Inkvine — Voice-Cloned Audiobook Reader (NaturalReader + Goodreads + Butterfly Engine)
// Local dev: SQLite via DATABASE_URL. Cloudflare: D1 via driver adapter (see src/lib/db.ts).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id          String       @id @default(cuid())
  title       String
  author      String?
  fileName    String
  fileType    String
  rawText     String
  charCount   Int
  coverUrl    String?
  coverPrompt String?
  voiceId     String       @default("tongtong")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chunks      AudioChunk[]
  progress    Float        @default(0)
  lastChunk   Int          @default(0)
  shelf       String?
  rating      Int?
  review      String?
  reviewAt    DateTime?
}

model VoiceProfile {
  id          String   @id @default(cuid())
  name        String
  voiceId     String
  description String
  accentColor String   @default("amber")
  gender      String   @default("neutral")
  language    String   @default("en")
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AudioChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  charCount  Int
  audioUrl   String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model Activity {
  id            String   @id @default(cuid())
  type          String
  reader        String
  readerAvatar  String   @default("")
  documentTitle String
  detail        String?
  createdAt     DateTime @default(now())
}

// Butterfly Engine — living books with animated pages
model LivingBook {
  id          String        @id @default(cuid())
  title       String
  author      String?
  coverPrompt String
  coverUrl    String?
  createdAt   DateTime      @default(now())
  pages       LivingPage[]
}

model LivingPage {
  id              String      @id @default(cuid())
  bookId          String
  book            LivingBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  text            String
  artPrompt       String
  artUrl          String?
  artStatus       String      @default("pending")
  videoUrl        String?
  videoStatus     String      @default("pending")
  ambientAudioUrl String?
  audioStatus     String      @default("pending")

  @@index([bookId])
}
