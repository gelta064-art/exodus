// Inkvine — Voice-Cloned Audiobook Reader (NaturalReader + Goodreads)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id          String       @id @default(cuid())
  title       String
  author      String?
  fileName    String
  fileType    String // txt | epub | pdf
  rawText     String
  charCount   Int
  coverUrl    String?
  coverPrompt String?
  voiceId     String       @default("tongtong")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chunks      AudioChunk[]
  progress    Float        @default(0) // 0..1 playback progress
  lastChunk   Int          @default(0)
  // Goodreads-style social
  shelf       String?      // want_to_read | reading | read
  rating      Int?         // 1..5
  review      String?
  reviewAt    DateTime?
}

model VoiceProfile {
  id          String   @id @default(cuid())
  name        String
  voiceId     String
  description String
  accentColor String   @default("amber")
  gender      String   @default("neutral")
  language    String   @default("en")
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AudioChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  charCount  Int
  audioUrl   String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// Goodreads-style community activity feed
model Activity {
  id         String   @id @default(cuid())
  type       String // started | finished | rated | reviewed | shelved | joined
  reader     String // display name of the (mock) reader
  readerAvatar String @default("")
  documentTitle String
  detail     String? // extra context (rating value, shelf name, review excerpt)
  createdAt  DateTime @default(now())
}
