DATABASE_URL=file:/home/z/my-project/db/custom.db

# Cloudflare R2 (S3-compatible object storage)
# Fill in R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY after creating an API token
# in Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=5f2e129817d71f0497248050bb7182d1
R2_BUCKET=inkvine-media
R2_ACCESS_KEY_ID=PLACEHOLDER_FILL_ME_IN
R2_SECRET_ACCESS_KEY=PLACEHOLDER_FILL_ME_IN
# Public URL prefix (set after enabling public access on the bucket, or leave blank)
R2_PUBLIC_URL=
